---
import BaseLayout from '../layouts/BaseLayout.astro';
import VolunteerApplicationForm from '../components/VolunteerApplicationForm.astro';
import { volunteerContent } from '../content/volunteer';

const c = volunteerContent;
---

<BaseLayout title="Volunteer" description={c.metaDescription} canonicalPath="/volunteer">
  <header class="border-b border-rule bg-white py-8 sm:py-9">
    <div class="site-shell measure-wide">
      <h1 class="font-display text-4xl sm:text-5xl">Volunteer</h1>
    </div>
  </header>

  <article class="section-pad">
    <div class="site-shell">
      <div class="measure-wide">
        {c.paragraphs.map((p) => <p class="body-copy mt-4 first:mt-0">{p}</p>)}
      </div>
      <div class="volunteer-form-shell mt-4 max-w-4xl">
        <VolunteerApplicationForm />
      </div>
    </div>
  </article>
</BaseLayout>
