---
import BaseLayout from '../layouts/BaseLayout.astro';
import DonationForm from '../components/donation/DonationForm.astro';
import DonationTrustInfo from '../components/donation/DonationTrustInfo.astro';
import DonationLegalDisclosures from '../components/donation/DonationLegalDisclosures.astro';
import { donateContent } from '../content/donate';
import { areCardPaymentsEnabled } from '../lib/donationForm';
import { resolveDonationProjectId } from '../lib/donationProjects';

const cardPaymentsEnabled = areCardPaymentsEnabled();
const donationProject = resolveDonationProjectId(Astro.url.searchParams.get('project'));
---

<BaseLayout
  title={donateContent.heading}
  description={donateContent.metaDescription}
  canonicalPath="/donate"
>
  <header class="section-pad-tight rule-bottom bg-white">
    <div class="site-shell measure-wide">
      <h1 class="text-4xl sm:text-5xl">{donateContent.heading}</h1>
      <p class="lede mt-5">{donateContent.intro}</p>
    </div>
  </header>

  <article class="section-pad">
    <div class="site-shell">
      <div class="donation-page-form mx-auto">
        <DonationForm
          cardPaymentsEnabled={cardPaymentsEnabled}
          donationProject={donationProject}
        />
      </div>

      <div class="donation-page-below mx-auto mt-14">
        <DonationTrustInfo />
        <DonationLegalDisclosures />
      </div>
    </div>
  </article>
</BaseLayout>
