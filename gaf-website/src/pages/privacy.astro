---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
import { privacyContent as c } from '../content/privacy';
---

<BaseLayout title="Privacy Policy" description={c.metaDescription} canonicalPath="/privacy">
  <header class="section-pad-tight rule-bottom bg-white">
    <div class="site-shell measure-wide">
      <h1 class="text-4xl sm:text-5xl">Privacy Policy</h1>
      <p class="mt-4 font-sans text-sm text-ink-soft">Last updated: {c.lastUpdated}</p>
      <p class="lede mt-5">{c.intro}</p>
    </div>
  </header>

  <article class="section-pad">
    <div class="site-shell">
      <div class="prose-editorial measure-wide">
        <h2>{c.informationWeCollect.heading}</h2>
        {c.informationWeCollect.paragraphs.map((p) => <p>{p}</p>)}

        <h2>{c.automatic.heading}</h2>
        <p>{c.automatic.body}</p>

        <h2>{c.howWeUse.heading}</h2>
        <p>{c.howWeUse.intro}</p>
        <ul>
          {c.howWeUse.items.map((item) => <li>{item}</li>)}
        </ul>

        <h2>{c.volunteerApplications.heading}</h2>
        {c.volunteerApplications.paragraphs.map((p) => <p>{p}</p>)}

        <h2>{c.donations.heading}</h2>
        {c.donations.paragraphs.map((p) => <p>{p}</p>)}

        <h2>{c.howWeShare.heading}</h2>
        {c.howWeShare.paragraphs.map((p) => <p>{p}</p>)}

        <h2>{c.dataSecurity.heading}</h2>
        <p>{c.dataSecurity.body}</p>

        <h2>{c.dataRetention.heading}</h2>
        <p>{c.dataRetention.body}</p>

        <h2>{c.thirdParty.heading}</h2>
        <p>{c.thirdParty.body}</p>

        <h2>{c.yourInformation.heading}</h2>
        <p>{c.yourInformation.body}</p>

        <h2>{c.changes.heading}</h2>
        <p>{c.changes.body}</p>

        <h2>{c.contact.heading}</h2>
        <p>{c.contact.intro}</p>
        <p>
          <a href={`mailto:${site.publicEmail}`}>{site.publicEmail}</a>
        </p>
      </div>
    </div>
  </article>
</BaseLayout>
