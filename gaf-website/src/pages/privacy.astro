---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
---

<BaseLayout
  title="Privacy"
  description={`Privacy practices for the ${site.organizationName} website.`}
  canonicalPath="/privacy"
>
  <header class="section-pad-tight rule-bottom">
    <div class="site-shell measure-wide">
      <p class="kicker">Legal</p>
      <h1 class="mt-3 text-4xl sm:text-5xl">Privacy policy</h1>
      <p class="lede mt-5">Privacy posture for the initial public website.</p>
    </div>
  </header>

  <article class="section-pad">
    <div class="site-shell prose-editorial">
      <h2>Overview</h2>
      <p>
        The initial website for Golden Archive Foundation is a static informational site. It is
        designed to present organization and project information without advertising cookies,
        behavioral tracking, online donations, account registration, or public submission forms.
      </p>

      <h2>What this initial website does not do</h2>
      <ul>
        <li>It does not use advertising cookies.</li>
        <li>It does not use behavioral tracking.</li>
        <li>It does not process online donations.</li>
        <li>It does not currently provide account registration.</li>
        <li>It does not currently operate public submission forms.</li>
      </ul>

      <h2>Information you may choose to share</h2>
      <p>
        If a public email address is published, any message you send by email is voluntary. Email
        correspondence is handled for the purpose of responding to your inquiry and related
        administrative needs.
      </p>

      <h2>Hosting and technical logs</h2>
      <p>
        Website hosting providers may generate standard technical logs such as IP address, request
        time, and requested URL as part of ordinary network operation and security. Those logs are
        controlled by the hosting environment rather than by application-level tracking on this
        site.
      </p>

      <h2>Policy updates</h2>
      <p>
        This privacy policy must be updated before forms, analytics, donations, mailing-list tools,
        or other data-collection features are introduced.
      </p>

      <h2>Contact</h2>
      {
        site.publicEmail ? (
          <p>
            Privacy questions may be sent to{' '}
            <a href={`mailto:${site.publicEmail}`}>{site.publicEmail}</a>.
          </p>
        ) : (
          <p>
            A public contact channel for privacy questions will be added before the site launches.
            See the <a href="/contact">Contact</a> page for current status.
          </p>
        )
      }
    </div>
  </article>
</BaseLayout>
