---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';

const inquiryCategories = [
  {
    title: 'General inquiries',
    text: 'Questions about the foundation, its mission, or this website.',
  },
  {
    title: 'Research collaboration',
    text: 'Proposals or questions related to shared research and documentary work.',
  },
  {
    title: 'Academic advising',
    text: 'Subject-matter advising and scholarly consultation inquiries.',
  },
  {
    title: 'Library or museum collaboration',
    text: 'Institutional partnership and collections-related conversations.',
  },
  {
    title: 'Volunteer interest',
    text: 'Interest in editorial, research, design, or related volunteer roles.',
  },
  {
    title: 'Media inquiries',
    text: 'Press and media questions about the foundation or its projects.',
  },
];
---

<BaseLayout
  title="Contact"
  description={`Contact ${site.organizationName} for research, volunteer, institutional, and media inquiries.`}
  canonicalPath="/contact"
>
  <header class="section-pad-tight rule-bottom">
    <div class="site-shell measure-wide">
      <p class="kicker">Contact</p>
      <h1 class="mt-3 text-4xl sm:text-5xl">Contact the foundation</h1>
      <p class="lede mt-5">
        Use the categories below to frame an inquiry. A public contact channel will be published
        when available. This site does not include a backend contact form.
      </p>
    </div>
  </header>

  <section class="section-pad">
    <div class="site-shell grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <h2 class="font-display text-2xl">Public contact</h2>
        {
          site.publicEmail ? (
            <p class="body-copy mt-4">
              Email: <a href={`mailto:${site.publicEmail}`}>{site.publicEmail}</a>
            </p>
          ) : (
            <p class="body-copy mt-4">
              Public contact information will be added before the site launches.
            </p>
          )
        }
        {
          site.mailingAddress ? (
            <p class="body-copy mt-3">
              Mailing address:
              <br />
              {site.mailingAddress}
            </p>
          ) : null
        }
      </div>
      <div class="lg:col-span-7">
        <h2 class="font-display text-2xl">Inquiry categories</h2>
        <ul class="mt-6 divide-y divide-rule border-y border-rule">
          {
            inquiryCategories.map((item) => (
              <li class="py-4">
                <h3 class="font-display text-lg">{item.title}</h3>
                <p class="body-copy mt-1 text-sm">{item.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
