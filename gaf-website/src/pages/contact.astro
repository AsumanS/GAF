---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
import { contactContent as c } from '../content/contact';

const email = site.publicEmail;
---

<BaseLayout
  title="Contact"
  description={c.metaDescription}
  canonicalPath="/contact"
>
  <header class="section-pad-tight rule-bottom bg-white">
    <div class="site-shell measure-wide">
      <h1 class="text-4xl sm:text-5xl">Contact</h1>
      <p class="lede mt-5 max-w-3xl">{c.intro}</p>
    </div>
  </header>

  <section class="section-pad">
    <div class="site-shell">
      <div class="grid gap-10 lg:grid-cols-2 lg:gap-12">
        <section aria-labelledby="email-heading">
          <h2 id="email-heading" class="font-display text-2xl sm:text-3xl">
            {c.email.heading}
          </h2>
          {
            email ? (
              <p class="mt-4">
                <a
                  href={`mailto:${email}`}
                  class="font-sans text-lg font-semibold text-ink no-underline hover:text-accent"
                >
                  {email}
                </a>
              </p>
            ) : (
              <p class="body-copy mt-4">
                Public contact information will be added before the site launches.
              </p>
            )
          }
          <p class="body-copy mt-4 max-w-xl">{c.email.note}</p>
        </section>

        <section
          class="border border-rule bg-white p-7 sm:p-9"
          aria-labelledby="volunteer-heading"
        >
          <h2 id="volunteer-heading" class="font-display text-2xl sm:text-3xl">
            {c.volunteer.heading}
          </h2>
          <p class="body-copy mt-4">{c.volunteer.body}</p>
          <p class="mt-6">
            <a href={c.volunteer.href} class="project-involve-cta">
              {c.volunteer.ctaLabel}
              <span aria-hidden="true">→</span>
            </a>
          </p>
        </section>
      </div>
    </div>
  </section>
</BaseLayout>
