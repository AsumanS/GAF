---
import BaseLayout from '../layouts/BaseLayout.astro';
import { aboutContent } from '../content/about';

const people = aboutContent.people.filter((person) => person.name.trim() && person.role.trim());
---

<BaseLayout title="About" description={aboutContent.metaDescription} canonicalPath="/about">
  <header class="section-pad-tight rule-bottom bg-white">
    <div class="site-shell measure-wide">
      <p class="nonprofit-mark">501(c)(3) Public Charity</p>
      <h1 class="mt-3 text-4xl sm:text-5xl">About Golden Archive Foundation</h1>
      <p class="lede mt-5 max-w-3xl">{aboutContent.intro}</p>
    </div>
  </header>

  <article class="section-pad bg-canvas">
    <div class="site-shell">
      <div class="grid gap-6 lg:grid-cols-2">
        <section class="border border-rule bg-white p-7 sm:p-9" aria-labelledby="who-we-are">
          <h2 id="who-we-are" class="font-display text-3xl">Who We Are</h2>
          <div class="mt-5 space-y-5">
            {aboutContent.whoWeAre.map((paragraph) => <p class="body-copy">{paragraph}</p>)}
          </div>
        </section>

        <section
          class="border border-rule bg-project-a p-7 sm:p-9"
          aria-labelledby="mission-and-vision"
        >
          <h2 id="mission-and-vision" class="font-display text-3xl">Mission &amp; Vision</h2>
          <div class="mt-5 space-y-5">
            {aboutContent.missionAndVision.map((paragraph) => <p class="body-copy">{paragraph}</p>)}
          </div>
        </section>
      </div>

      <section class="mx-auto mt-14 max-w-4xl text-center" aria-labelledby="why-it-matters">
        <h2 id="why-it-matters" class="font-display text-3xl sm:text-4xl">Why It Matters</h2>
        <p class="lede mt-5">{aboutContent.whyItMatters}</p>
      </section>

      <section class="mt-14 border border-accent/45 bg-white p-7 sm:p-10" aria-labelledby="areas">
        <h2 id="areas" class="sr-only">Areas of Work</h2>
        <div class="grid gap-x-10 gap-y-10 md:grid-cols-2 lg:grid-cols-3">
          {
            aboutContent.areasOfWork.map((area) => (
              <section>
                <h3 class="font-display text-2xl">{area.title}</h3>
                <p class="body-copy mt-3">{area.description}</p>
              </section>
            ))
          }
        </div>
      </section>

      {
        people.length > 0 ? (
          <section class="mt-16 max-w-3xl" aria-labelledby="people-heading">
            <h2 id="people-heading" class="font-display text-3xl">
              People
            </h2>
            <ul class="mt-8 space-y-8">
              {people.map((person) => (
                <li class="grid gap-4 border-t border-rule pt-6 sm:grid-cols-[8rem_1fr]">
                  {person.photoSrc ? (
                    <img
                      src={person.photoSrc}
                      alt={person.photoAlt || person.name}
                      width="160"
                      height="200"
                      class="h-auto w-32 object-cover"
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <div class="hidden sm:block" />
                  )}
                  <div>
                    <h3 class="font-display text-xl">{person.name}</h3>
                    <p class="meta mt-1">{person.role}</p>
                    {person.bio ? <p class="body-copy mt-3 text-sm">{person.bio}</p> : null}
                  </div>
                </li>
              ))}
            </ul>
          </section>
        ) : null
      }
    </div>
  </article>
</BaseLayout>
