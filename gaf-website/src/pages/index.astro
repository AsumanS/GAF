---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/home.css';
import { site } from '../config/site';
import { homeContent } from '../content/home';
import { getProjectBySlug } from '../data/projects';

const donateHref = site.donationUrl || '/donate';

const lostWorks = getProjectBySlug('hidden-works');
const worlds = getProjectBySlug('worlds');
if (!lostWorks || !worlds) {
  throw new Error('Home project cards require hidden-works and worlds project data.');
}

const lostCard = homeContent.projects['hidden-works'];
const worldsCard = homeContent.projects.worlds;
---

<BaseLayout
  title={site.organizationName}
  description={homeContent.metaDescription}
  canonicalPath="/"
  growMain={false}
>
  <div class="home">
    <section class="hero" aria-labelledby="hero-title">
      <figure class="hero-visual">
        <img
          src="/assets/hero-art.jpg"
          alt="Artistic landscape representing the foundation's cultural and creative work"
          width="1412"
          height="796"
        />
      </figure>

      <div class="site-shell hero-inner">
        <div class="hero-copy">
          <h1 id="hero-title">
            <span>{homeContent.hero.titleLineOne}</span>
            <span>{homeContent.hero.titleLineTwo}</span>
          </h1>
          <p class="hero-subtitle">{homeContent.hero.subtitle}</p>
          <p class="nonprofit-line">
            <span>{homeContent.hero.nonprofitLabel}</span>
          </p>
          <div class="hero-actions" aria-label="Primary actions">
            <a class="btn-primary" href={donateHref}>
              <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18">
                <path d="M12 20.5 4.4 13A5 5 0 0 1 11 5.5L12 6.6l1-1.1A5 5 0 0 1 19.6 13L12 20.5Z"
                ></path>
              </svg>
              Donate
            </a>
            <a class="btn-secondary" href="/volunteer">
              <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18">
                <circle cx="8" cy="8" r="3"></circle>
                <circle cx="16.5" cy="9" r="2.5"></circle>
                <path
                  d="M2.8 19c.4-3.6 2.3-5.5 5.2-5.5s4.8 1.9 5.2 5.5M13.5 14.5c2.4-.8 5.2.4 5.7 4.5"
                ></path>
              </svg>
              Volunteer
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="projects" id="projects" aria-labelledby="projects-title">
      <div class="site-shell projects-inner">
        <div class="section-heading-row">
          <h2 id="projects-title">
            <a href="/projects">{homeContent.projectsHeading}</a>
          </h2>
          <span aria-hidden="true"></span>
        </div>

        <div class="project-grid">
          <a class="project project-lost" href={lostWorks.href}>
            <div class="project-image">
              <img src={lostWorks.image.src} alt="" width="640" height="470" />
            </div>
            <div class="project-copy project-copy-dark">
              <h3>{lostWorks.title}</h3>
              <span class="project-rule" aria-hidden="true"></span>
              <p>{lostCard.description}</p>
              <span class="project-link">
                {lostCard.linkLabel}
                <span aria-hidden="true">→</span>
              </span>
            </div>
          </a>

          <a class="project project-worlds" href={worlds.href}>
            <div class="project-image">
              <img src={worlds.image.src} alt="" width="576" height="470" />
            </div>
            <div class="project-copy project-copy-light">
              <h3>{worlds.title}</h3>
              <span class="project-rule" aria-hidden="true"></span>
              <p>{worldsCard.description}</p>
              <span class="project-link">
                {worldsCard.linkLabel}
                <span aria-hidden="true">→</span>
              </span>
            </div>
          </a>
        </div>
      </div>
    </section>

    <section class="donation" id="donate" aria-labelledby="donation-title">
      <div class="donation-art" aria-hidden="true"></div>
      <div class="site-shell donation-inner">
        <div class="donation-symbol" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="44" height="44">
            <path d="M12 20.5 4.4 13A5 5 0 0 1 11 5.5L12 6.6l1-1.1A5 5 0 0 1 19.6 13L12 20.5Z"
            ></path>
          </svg>
        </div>
        <div class="donation-copy">
          <h2 id="donation-title">{homeContent.donation.heading}</h2>
          <p>{homeContent.donation.description}</p>
        </div>
        <a class="btn-primary" href={donateHref}>
          <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18">
            <path d="M12 20.5 4.4 13A5 5 0 0 1 11 5.5L12 6.6l1-1.1A5 5 0 0 1 19.6 13L12 20.5Z"
            ></path>
          </svg>
          Donate
        </a>
        <p class="donation-legal">{homeContent.donation.legal}</p>
      </div>
    </section>
  </div>
</BaseLayout>
