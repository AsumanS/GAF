---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectEntry from '../../components/editorial/ProjectEntry.astro';
import { site } from '../../config/site';
import { projects } from '../../data/projects';
---

<BaseLayout
  title="Projects"
  description={`Research and publishing projects of ${site.organizationName}, including Hidden Works and Worlds Imagined.`}
  canonicalPath="/projects"
>
  <header class="section-pad-tight rule-bottom">
    <div class="site-shell measure-wide">
      <p class="kicker">Projects</p>
      <h1 class="mt-3 text-4xl sm:text-5xl">Our Projects — intro</h1>
      <p class="lede mt-5 max-w-3xl">
        Golden Archive Foundation develops projects that bring overlooked cultural material back into
        public view and explore the many ways people have understood, recorded, and imagined their
        world. Each project begins with research, but its purpose is broader: to make cultural
        knowledge easier to discover, experience, and share.
      </p>
    </div>
  </header>

  <section class="section-pad">
    <div class="site-shell">
      {projects.map((project, index) => (
        <ProjectEntry project={project} index={index} />
      ))}
    </div>
  </section>
</BaseLayout>
