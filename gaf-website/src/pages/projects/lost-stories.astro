---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjectBySlug } from '../../data/projects';
import { lostStoriesContent } from '../../content/projects/lost-stories';

const project = getProjectBySlug('lost-stories');
if (!project) throw new Error('Lost Stories project data is missing.');

const c = lostStoriesContent;
---

<BaseLayout title={project.title} description={c.metaDescription} canonicalPath={project.href}>
  <header class="section-pad-tight rule-bottom">
    <div class="site-shell">
      <p class="kicker">Project dossier · {project.number}</p>
      <h1 class="mt-3 text-4xl sm:text-5xl">{project.title}</h1>
      <p class="status-line mt-4">{c.statusLine}</p>
      <p class="lede measure mt-6">{project.premise}</p>
    </div>
  </header>

  <article>
    <!-- Contents -->
    <nav class="section-pad-tight band-panel" aria-label="Dossier contents">
      <div class="site-shell measure">
        <h2 class="meta">Contents</h2>
        <ol class="mt-4 space-y-2 font-serif text-ink-muted">
          <li><a href="#premise">Project premise</a></li>
          <li><a href="#discovery-problem">The precise discovery problem</a></li>
          <li><a href="#unavailable">What “unavailable to general readers” means</a></li>
          <li><a href="#eligibility">Proposed eligibility framework</a></li>
          <li><a href="#categories">Two discovery categories</a></li>
          <li><a href="#evidence">Evidence expected from entrants</a></li>
          <li><a href="#review">Review and verification methodology</a></li>
          <li><a href="#pathway">Publication-development pathway</a></li>
          <li><a href="#unresolved">Current unresolved decisions</a></li>
          <li><a href="#open-questions">Questions before submissions open</a></li>
        </ol>
      </div>
    </nav>

    <div class="section-pad">
      <div class="site-shell grid gap-12 lg:grid-cols-12">
        <div class="prose-editorial lg:col-span-7">
          <section aria-labelledby="premise">
            <h2 id="premise">{c.premise.heading}</h2>
            {c.premise.paragraphs.map((p) => <p>{p}</p>)}
          </section>

          <section aria-labelledby="discovery-problem">
            <h2 id="discovery-problem">{c.discoveryProblem.heading}</h2>
            {c.discoveryProblem.paragraphs.map((p) => <p>{p}</p>)}
          </section>

          <section aria-labelledby="unavailable">
            <h2 id="unavailable">{c.unavailableMeans.heading}</h2>
            {c.unavailableMeans.paragraphs.map((p) => <p>{p}</p>)}
          </section>

          <section aria-labelledby="eligibility">
            <h2 id="eligibility">{c.eligibility.heading}</h2>
            {c.eligibility.paragraphs.map((p) => <p>{p}</p>)}
          </section>
        </div>

        <aside class="lg:col-span-5 lg:pt-12">
          <div class="border border-rule bg-bone p-5 sm:p-6">
            <h2 class="meta">File note</h2>
            <p class="mt-3 font-serif text-sm leading-relaxed text-ink-muted">
              This page is a working dossier, not a finished call for entries. Official rules will
              supersede the outline below when published.
            </p>
            <dl class="mt-6 space-y-3 font-sans text-sm">
              <div class="flex justify-between gap-4 border-t border-rule pt-3">
                <dt class="text-ink-soft">Phase</dt>
                <dd>{project.statusLabel}</dd>
              </div>
              <div class="flex justify-between gap-4 border-t border-rule pt-3">
                <dt class="text-ink-soft">Submissions</dt>
                <dd>Not yet open</dd>
              </div>
              <div class="flex justify-between gap-4 border-t border-rule pt-3">
                <dt class="text-ink-soft">Form</dt>
                <dd>Research & discovery</dd>
              </div>
            </dl>
          </div>
        </aside>
      </div>
    </div>

    <section class="section-pad band-bone" aria-labelledby="categories">
      <div class="site-shell">
        <h2 id="categories" class="text-3xl">{c.categories.heading}</h2>
        <div class="mt-8 grid gap-8 lg:grid-cols-2">
          {
            c.categories.items.map((item, i) => (
              <div class="border-t border-rule pt-5">
                <p class="meta text-brass">{String(i + 1).padStart(2, '0')}</p>
                <h3 class="mt-2 font-display text-2xl">{item.title}</h3>
                <p class="body-copy mt-3">{item.text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section-pad" aria-labelledby="evidence">
      <div class="site-shell grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2 id="evidence" class="text-3xl">{c.evidence.heading}</h2>
        </div>
        <ol class="lg:col-span-7 space-y-4 font-serif text-ink-muted">
          {
            c.evidence.items.map((item, i) => (
              <li class="grid grid-cols-[2rem_1fr] gap-3 border-b border-rule pb-4">
                <span class="meta text-brass">{String(i + 1).padStart(2, '0')}</span>
                <span>{item}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="section-pad band-panel" aria-labelledby="review">
      <div class="site-shell prose-editorial">
        <h2 id="review">{c.review.heading}</h2>
        {c.review.paragraphs.map((p) => <p>{p}</p>)}
        <h2 id="pathway">{c.pathway.heading}</h2>
        {c.pathway.paragraphs.map((p) => <p>{p}</p>)}
        <h2 id="unresolved">{c.unresolved.heading}</h2>
        <ul>
          {c.unresolved.items.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </section>

    <section class="section-pad" aria-labelledby="open-questions">
      <div class="site-shell">
        <div class="measure-wide">
          <p class="kicker">Before the call</p>
          <h2 id="open-questions" class="mt-3 text-3xl sm:text-4xl">
            Questions the project must answer before submissions open
          </h2>
          <p class="body-copy mt-4">
            These are design questions, not a FAQ of finished policy. Their presence is meant to
            show rigorous development rather than incompleteness for its own sake.
          </p>
        </div>
        <div class="mt-10 space-y-8 measure-wide">
          {
            c.openQuestions.map((q) => (
              <div class="border-t border-rule pt-6">
                <h3 class="font-display text-xl text-ink">{q.question}</h3>
                <p class="body-copy mt-3">{q.note}</p>
              </div>
            ))
          }
        </div>
        <p class="mt-12">
          <a href="/projects" class="editorial-link">Return to the project index</a>
          {' · '}
          <a href="/contact" class="editorial-link">Contact the foundation</a>
        </p>
      </div>
    </section>
  </article>
</BaseLayout>
