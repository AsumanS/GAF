---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EvidenceLayersDiagram from '../../components/editorial/EvidenceLayersDiagram.astro';
import { getProjectBySlug } from '../../data/projects';
import { worldsContent } from '../../content/projects/worlds';

const project = getProjectBySlug('worlds');
if (!project) throw new Error('Worlds Imagined project data is missing.');

const c = worldsContent;
---

<BaseLayout title={project.title} description={c.metaDescription} canonicalPath={project.href}>
  <header class="section-pad-tight rule-bottom">
    <div class="site-shell">
      <p class="kicker">Research framework · {project.number}</p>
      <h1 class="mt-3 text-4xl sm:text-5xl">{project.title}</h1>
      <p class="status-line mt-4">{c.statusLine}</p>
      <p class="lede measure mt-6">{project.premise}</p>
    </div>
  </header>

  <article>
    <section class="section-pad" aria-labelledby="essay">
      <div class="site-shell grid gap-10 lg:grid-cols-12">
        <div class="prose-editorial lg:col-span-7">
          <h2 id="essay">{c.essay.heading}</h2>
          {c.essay.paragraphs.map((p) => <p>{p}</p>)}
          <h2 id="method">{c.methodNotes.heading}</h2>
          {c.methodNotes.paragraphs.map((p) => <p>{p}</p>)}
        </div>
        <aside class="lg:col-span-5">
          <div class="border-l border-brass pl-5">
            <h2 class="meta">Marginal note</h2>
            <p class="mt-3 font-serif text-sm leading-relaxed text-ink-muted">
              Worlds Imagined is built as a framework first. Diagrams and illustrations are tools
              for explanation, not substitutes for sources.
            </p>
          </div>
        </aside>
      </div>
    </section>

    <section class="section-pad band-ink" aria-labelledby="diagram-heading">
      <div class="site-shell grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="meta text-brass-soft">Method diagram</p>
          <h2 id="diagram-heading" class="mt-3 text-3xl text-bone">{c.diagram.heading}</h2>
          <p class="mt-4 font-serif text-bone/80 leading-relaxed">
            {c.diagram.caption}
          </p>
          <p class="mt-4 font-serif text-sm leading-relaxed text-bone/65">
            Historical sources remain evidence. Later interpretation is commentary. Modern
            reconstruction is a hypothesis constrained by that evidence. Public illustration is
            communication—and must say which of the prior layers it represents.
          </p>
        </div>
        <div class="lg:col-span-7 [&_figcaption]:text-bone/70">
          <EvidenceLayersDiagram>
            {c.diagram.caption}
          </EvidenceLayersDiagram>
        </div>
      </div>
    </section>

    <section class="section-pad" aria-labelledby="sources">
      <div class="site-shell">
        <h2 id="sources" class="text-3xl">{c.sourceCategories.heading}</h2>
        <ol class="mt-8 space-y-0">
          {
            c.sourceCategories.items.map((item, i) => (
              <li class="grid gap-2 border-t border-rule py-5 sm:grid-cols-[4rem_12rem_1fr] sm:gap-6">
                <span class="meta text-brass">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="font-display text-xl">{item.title}</h3>
                <p class="body-copy">{item.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="section-pad band-panel" aria-labelledby="reconstruction">
      <div class="site-shell grid gap-10 lg:grid-cols-2">
        <div>
          <h2 id="reconstruction" class="text-3xl">{c.reconstructionRules.heading}</h2>
          <ul class="mt-6 space-y-3">
            {
              c.reconstructionRules.items.map((item) => (
                <li class="border-t border-rule pt-3 font-serif text-ink-muted">{item}</li>
              ))
            }
          </ul>
        </div>
        <div>
          <h2 id="cartography" class="text-3xl">{c.cartographicQuestions.heading}</h2>
          <ul class="mt-6 space-y-3">
            {
              c.cartographicQuestions.items.map((item) => (
                <li class="border-t border-rule pt-3 font-serif text-ink-muted">{item}</li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <section class="section-pad" aria-labelledby="disciplines">
      <div class="site-shell">
        <h2 id="disciplines" class="text-3xl">{c.disciplines.heading}</h2>
        <p class="body-copy measure mt-4">
          Disciplines appear here as an editorial index, not as a set of identical feature tiles.
        </p>
        <dl class="mt-8 divide-y divide-rule border-y border-rule">
          {
            c.disciplines.items.map((item) => (
              <div class="grid gap-1 py-4 sm:grid-cols-[16rem_1fr] sm:gap-8">
                <dt class="font-display text-lg text-ink">{item.title}</dt>
                <dd class="font-serif text-ink-muted">{item.note}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <section class="section-pad band-bone" aria-labelledby="how-built">
      <div class="site-shell">
        <h2 id="how-built" class="text-3xl sm:text-4xl">{c.howBuilt.heading}</h2>
        <p class="mt-4 measure border-l border-oxblood pl-4 font-sans text-sm text-ink-muted">
          {c.howBuilt.disclaimer}
        </p>
        <ol class="mt-10 space-y-6 max-w-3xl">
          {
            c.howBuilt.steps.map((step, i) => (
              <li class="grid gap-2 sm:grid-cols-[3rem_1fr] sm:gap-6">
                <span class="meta text-brass">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <h3 class="font-display text-xl">{step.title}</h3>
                  <p class="body-copy mt-2">{step.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <p class="mt-12">
          <a href="/projects" class="editorial-link">Return to the project index</a>
          {' · '}
          <a href="/contact" class="editorial-link">Contact the foundation</a>
        </p>
      </div>
    </section>
  </article>
</BaseLayout>
