---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';

const toBePublished = 'To be published.';
---

<BaseLayout
  title="Transparency"
  description={`Tax-exempt status, governance, and public accountability information for ${site.organizationName}.`}
  canonicalPath="/transparency"
>
  <header class="section-pad-tight rule-bottom">
    <div class="site-shell measure-wide">
      <p class="kicker">Transparency</p>
      <h1 class="mt-3 text-4xl sm:text-5xl">Public accountability</h1>
      <p class="lede mt-5">
        Records appear here when they exist. Empty fields and “to be published” notices are
        intentional. They mark the difference between verified facts and unfinished paperwork.
      </p>
    </div>
  </header>

  <article class="section-pad">
    <div class="site-shell prose-editorial">
      <h2>IRS status</h2>
      <p>
        Golden Archive Foundation is recognized by the Internal Revenue Service as a tax-exempt
        organization under Section 501(c)(3).
      </p>
      <p>Legal status: {site.legalStatus}</p>

      <h2>Foundation classification</h2>
      <p>{site.foundationClassification}</p>

      <h2>Employer Identification Number (EIN)</h2>
      <p>{site.ein || toBePublished}</p>

      <h2>Determination letter</h2>
      {
        site.determinationLetterUrl ? (
          <p>
            <a href={site.determinationLetterUrl}>View the IRS determination letter</a>
          </p>
        ) : (
          <p>{toBePublished}</p>
        )
      }

      <h2>IRS listing</h2>
      {
        site.irsSearchUrl ? (
          <p>
            <a href={site.irsSearchUrl}>Search the IRS Tax Exempt Organization Search tool</a>
          </p>
        ) : (
          <p>{toBePublished}</p>
        )
      }

      <h2>Governance documents</h2>
      <p>{toBePublished}</p>

      <h2>Annual filings</h2>
      <p>{toBePublished}</p>

      <h2>Financial information</h2>
      <p>{toBePublished}</p>

      <h2>Conflict-of-interest policy</h2>
      <p>{toBePublished}</p>

      <h2>Contact information</h2>
      {
        site.publicEmail || site.mailingAddress ? (
          <ul>
            {site.publicEmail ? (
              <li>
                Email: <a href={`mailto:${site.publicEmail}`}>{site.publicEmail}</a>
              </li>
            ) : null}
            {site.mailingAddress ? <li>Mailing address: {site.mailingAddress}</li> : null}
          </ul>
        ) : (
          <p>
            Public contact information will be added before the site launches. See the{' '}
            <a href="/contact">Contact</a> page for inquiry categories.
          </p>
        )
      }

      <h2>Online giving</h2>
      <p>
        Online giving is not currently available. Golden Archive Foundation is completing the
        compliance and administrative work required for future fundraising activities.
      </p>
    </div>
  </article>
</BaseLayout>
