---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
import { transparencyContent as c } from '../content/transparency';

function linkClass(hasHref: boolean) {
  return hasHref
    ? 'editorial-link'
    : 'font-sans text-sm font-semibold text-ink-soft no-underline';
}
---

<BaseLayout
  title="Transparency"
  description={c.metaDescription}
  canonicalPath="/transparency"
>
  <header class="section-pad-tight rule-bottom bg-white">
    <div class="site-shell measure-wide">
      <h1 class="text-4xl sm:text-5xl">Transparency</h1>
      <p class="lede mt-5">{c.intro}</p>
    </div>
  </header>

  <article class="section-pad">
    <div class="site-shell">
      <div class="prose-editorial measure-wide">
      <section class="mt-0" aria-labelledby="tax-exempt-heading">
        <h2 id="tax-exempt-heading">{c.taxExempt.heading}</h2>
        <p>{c.taxExempt.body}</p>
        <p>EIN: {site.ein || ''}</p>
        <ul class="mt-6 list-none space-y-3 pl-0">
          {
            c.taxExempt.links.map((item) => (
              <li>
                {item.href ? (
                  <a href={item.href} class={linkClass(true)}>
                    {item.label}
                    <span aria-hidden="true"> →</span>
                  </a>
                ) : (
                  <span class={linkClass(false)}>
                    {item.label}
                    <span aria-hidden="true"> →</span>
                  </span>
                )}
              </li>
            ))
          }
        </ul>
      </section>

      <section class="mt-12" aria-labelledby="governance-heading">
        <h2 id="governance-heading">{c.governance.heading}</h2>
        <ul class="mt-6 list-none space-y-3 pl-0">
          {
            c.governance.links.map((item) => (
              <li>
                {item.href ? (
                  <a href={item.href} class={linkClass(true)}>
                    {item.label}
                    <span aria-hidden="true"> →</span>
                  </a>
                ) : (
                  <span class={linkClass(false)}>
                    {item.label}
                    <span aria-hidden="true"> →</span>
                  </span>
                )}
              </li>
            ))
          }
        </ul>
      </section>

      <section class="mt-12" aria-labelledby="financial-heading">
        <h2 id="financial-heading">{c.financial.heading}</h2>
        <h3>{c.financial.year}</h3>
        <ul class="mt-4 list-none space-y-3 pl-0">
          {
            c.financial.links.map((item) => (
              <li>
                {item.href ? (
                  <a href={item.href} class={linkClass(true)}>
                    {item.label}
                    <span aria-hidden="true"> →</span>
                  </a>
                ) : (
                  <span class={linkClass(false)}>
                    {item.label}
                    <span aria-hidden="true"> →</span>
                  </span>
                )}
              </li>
            ))
          }
        </ul>
      </section>
      </div>
    </div>
  </article>
</BaseLayout>
