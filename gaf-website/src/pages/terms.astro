---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
---

<BaseLayout
  title="Terms"
  description={`Website terms of use for ${site.organizationName}.`}
  canonicalPath="/terms"
>
  <header class="section-pad-tight rule-bottom">
    <div class="site-shell measure-wide">
      <p class="kicker">Legal</p>
      <h1 class="mt-3 text-4xl sm:text-5xl">Website terms</h1>
      <p class="lede mt-5">Terms governing use of the Golden Archive Foundation website.</p>
    </div>
  </header>

  <article class="section-pad">
    <div class="site-shell prose-editorial">
      <h2>Informational content</h2>
      <p>
        Materials on this website are provided for general informational and educational purposes.
        They describe the foundation’s mission, projects, and public status as those items are
        prepared for release.
      </p>

      <h2>No professional advice</h2>
      <p>
        Nothing on this website constitutes legal, tax, financial, medical, or other professional
        advice.
      </p>

      <h2>Intellectual property</h2>
      <p>
        Unless otherwise noted, website design, original text, and original graphics produced for
        Golden Archive Foundation are protected by applicable intellectual property laws. Project
        pages may later present third-party works under separate rights statements and credit lines.
      </p>
      <p>
        You may link to public pages of this site. Do not present foundation materials in a way that
        suggests endorsement or affiliation without permission.
      </p>

      <h2>Third-party links</h2>
      <p>
        Links to external sites, including government resources, are provided for convenience. The
        foundation is not responsible for the content, privacy practices, or availability of
        third-party websites.
      </p>

      <h2>Project rules</h2>
      <p>
        Official rules for contests, calls, or participation programs—if and when published—govern
        those activities separately from these website terms. In the event of a conflict, the
        official project rules control for that project.
      </p>

      <h2>Changes to site content</h2>
      <p>
        The foundation may update, correct, or remove website content at any time. These terms may
        also be revised. The version posted on this page is the current version.
      </p>

      <h2>Contact</h2>
      {
        site.publicEmail ? (
          <p>
            Questions about these terms may be sent to{' '}
            <a href={`mailto:${site.publicEmail}`}>{site.publicEmail}</a>.
          </p>
        ) : (
          <p>
            A public contact channel will be added before the site launches. See the{' '}
            <a href="/contact">Contact</a> page for current status.
          </p>
        )
      }
    </div>
  </article>
</BaseLayout>
