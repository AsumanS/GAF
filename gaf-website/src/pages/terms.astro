---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
import { termsContent as c } from '../content/terms';
---

<BaseLayout title="Website Terms" description={c.metaDescription} canonicalPath="/terms">
  <header class="section-pad-tight rule-bottom bg-white">
    <div class="site-shell measure-wide">
      <h1 class="text-4xl sm:text-5xl">Website Terms</h1>
      <p class="mt-4 font-sans text-sm text-ink-soft">Last updated: {c.lastUpdated}</p>
      <p class="lede mt-5">{c.intro}</p>
    </div>
  </header>

  <article class="section-pad">
    <div class="site-shell">
      <div class="prose-editorial measure-wide">
        <h2>{c.useOfWebsite.heading}</h2>
        {c.useOfWebsite.paragraphs.map((p) => <p>{p}</p>)}

        <h2>{c.intellectualProperty.heading}</h2>
        {c.intellectualProperty.paragraphs.map((p) => <p>{p}</p>)}

        <h2>{c.submissions.heading}</h2>
        {c.submissions.paragraphs.map((p) => <p>{p}</p>)}

        <h2>{c.projectRules.heading}</h2>
        {c.projectRules.paragraphs.map((p) => <p>{p}</p>)}

        <h2>{c.donations.heading}</h2>
        {c.donations.paragraphs.map((p) => <p>{p}</p>)}

        <h2>{c.accuracy.heading}</h2>
        {c.accuracy.paragraphs.map((p) => <p>{p}</p>)}

        <h2>{c.disclaimer.heading}</h2>
        <p>{c.disclaimer.body}</p>

        <h2>{c.privacy.heading}</h2>
        <p>
          Use of personal information submitted through this website is described in our{' '}
          <a href={c.privacy.href} class="editorial-link">
            {c.privacy.label}
            <span aria-hidden="true"> →</span>
          </a>
        </p>

        <h2>{c.changes.heading}</h2>
        <p>{c.changes.body}</p>

        <h2>{c.governingLaw.heading}</h2>
        <p>{c.governingLaw.body}</p>

        <h2>{c.contact.heading}</h2>
        <p>{c.contact.intro}</p>
        <p>
          <a href={`mailto:${site.publicEmail}`}>{site.publicEmail}</a>
        </p>
      </div>
    </div>
  </article>
</BaseLayout>
