---
/**
 * Media figure with production-safe absence handling.
 * Development builds may show an understated placeholder; production collapses when src is empty.
 */
import type { MediaAssetRef } from '../../types/content';

type Props = {
  asset: MediaAssetRef;
  class?: string;
  priority?: boolean;
};

const { asset, class: className = '', priority = false } = Astro.props;
const isDev = import.meta.env.DEV;
const hasSrc = Boolean(asset.src?.trim());
const showDevPlaceholder = !hasSrc && isDev;
const showNothing = !hasSrc && !isDev;
---

{
  showNothing ? null : hasSrc ? (
    <figure class:list={['w-full', className]}>
      <img
        src={asset.src}
        alt={asset.alt}
        width="1600"
        height="1060"
        class="h-auto w-full object-cover"
        loading={priority ? 'eager' : 'lazy'}
        decoding="async"
        fetchpriority={priority ? 'high' : 'auto'}
      />
      {(asset.caption || asset.credit) && (
        <figcaption class="caption mt-3 border-t border-rule pt-2">
          {asset.caption}
          {asset.credit ? <span class="block">Credit: {asset.credit}</span> : null}
        </figcaption>
      )}
    </figure>
  ) : showDevPlaceholder ? (
    <aside
      class:list={[
        'border border-dashed border-rule-strong bg-canvas px-4 py-6 font-sans text-sm text-ink-soft',
        className,
      ]}
      aria-label="Development media placeholder"
    >
      <p class="kicker">Development placeholder</p>
      <p class="mt-3 text-ink-muted">
        <strong class="font-medium text-ink">Purpose:</strong> {asset.purpose}
      </p>
      <p class="mt-1">
        <strong class="font-medium text-ink">Suggested type:</strong> {asset.suggestedType}
      </p>
      <p class="mt-1">
        <strong class="font-medium text-ink">Rights:</strong> {asset.rightsStatus}
      </p>
      <p class="mt-1">
        <strong class="font-medium text-ink">Dimensions:</strong> {asset.dimensions}
      </p>
    </aside>
  ) : null
}
