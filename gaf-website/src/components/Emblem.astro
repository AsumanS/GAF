---
/**
 * Official GAF monogram mark (square logo).
 * Raster asset kept in /images/foundation/logo.png for crisp UI use.
 */
type Props = {
  class?: string;
  title?: string;
};

const { class: className = 'h-8 w-8', title } = Astro.props;
const labelled = Boolean(title);
---

<img
  class={className}
  src="/images/foundation/logo.png"
  width="64"
  height="64"
  alt={labelled ? title : ''}
  aria-hidden={labelled ? undefined : 'true'}
  decoding="async"
/>
