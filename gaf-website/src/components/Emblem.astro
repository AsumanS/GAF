---
/**
 * Original geometric monogram for Golden Archive Foundation.
 * Designed to remain legible at favicon size.
 */
type Props = {
  class?: string;
  title?: string;
};

const { class: className = 'h-8 w-8', title } = Astro.props;
const labelled = Boolean(title);
---

<svg
  class={className}
  viewBox="0 0 64 64"
  xmlns="http://www.w3.org/2000/svg"
  role={labelled ? 'img' : 'presentation'}
  aria-hidden={labelled ? undefined : 'true'}
  aria-label={title}
>
  {title ? <title>{title}</title> : null}
  <rect x="2" y="2" width="60" height="60" fill="none" stroke="currentColor" stroke-width="2"
  ></rect>
  <circle cx="32" cy="32" r="18" fill="none" stroke="currentColor" stroke-width="1.75"></circle>
  <path
    d="M22 38.5 V25.5 H30.2 C34.1 25.5 36.4 27.6 36.4 30.7 C36.4 33.8 34.1 35.8 30.2 35.8 H26.2 V38.5 Z M26.2 32.4 H29.7 C31.6 32.4 32.5 31.6 32.5 30.7 C32.5 29.8 31.6 29 29.7 29 H26.2 Z"
    fill="currentColor"></path>
  <path
    d="M38.2 25.5 H42 V38.5 H38.2 V33.2 L34.4 38.5 H31.8 L35.8 32.9 L32.1 25.5 H34.8 L38.2 31.1 Z"
    fill="currentColor"></path>
  <line
    x1="14"
    y1="14"
    x2="20"
    y2="14"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="square"></line>
  <line
    x1="14"
    y1="14"
    x2="14"
    y2="20"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="square"></line>
  <line
    x1="50"
    y1="50"
    x2="44"
    y2="50"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="square"></line>
  <line
    x1="50"
    y1="50"
    x2="50"
    y2="44"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="square"></line>
</svg>
