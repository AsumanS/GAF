---
import { site } from '../config/site';
import {
  countryOptions,
  preferredAvailabilityOptions,
  timeCommitmentOptions,
  timeZoneOptions,
  volunteerDurationOptions,
} from '../content/volunteerForm';

const formAction = site.volunteerFormAction.trim();
const turnstileSiteKey = (import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '').trim();
const canSubmit = Boolean(formAction && turnstileSiteKey);
---

<form
  class="volunteer-form"
  method="post"
  enctype="multipart/form-data"
  action={canSubmit ? formAction : undefined}
  aria-labelledby="volunteer-form-title"
  data-form-action={canSubmit ? formAction : ''}
  data-turnstile-sitekey={canSubmit ? turnstileSiteKey : ''}
>
  <h2 id="volunteer-form-title" class="font-display text-3xl sm:text-4xl">
    Volunteer Application
  </h2>
  <p class="body-copy mt-3">
    Required fields are marked with an asterisk (<span aria-hidden="true">*</span>).
  </p>

  <input type="hidden" name="submission_idempotency_key" value="" autocomplete="off" />

  <section class="volunteer-form-section" aria-labelledby="contact-info-heading">
    <h3 id="contact-info-heading" class="volunteer-form-section-title">Contact Information</h3>
    <div class="volunteer-form-grid">
      <div class="field">
        <label for="first-name">First Name <span class="req" aria-hidden="true">*</span></label>
        <input id="first-name" name="first_name" type="text" autocomplete="given-name" required />
      </div>
      <div class="field">
        <label for="last-name">Last Name <span class="req" aria-hidden="true">*</span></label>
        <input id="last-name" name="last_name" type="text" autocomplete="family-name" required />
      </div>
      <div class="field">
        <label for="email">Email <span class="req" aria-hidden="true">*</span></label>
        <input id="email" name="email" type="email" autocomplete="email" required />
      </div>
      <div class="field">
        <label for="phone">Phone <span class="req" aria-hidden="true">*</span></label>
        <input id="phone" name="phone" type="tel" autocomplete="tel" required />
      </div>
      <div class="field">
        <label for="city">City <span class="req" aria-hidden="true">*</span></label>
        <input id="city" name="city" type="text" autocomplete="address-level2" required />
      </div>
      <div class="field">
        <label for="state-region">State / Region <span class="req" aria-hidden="true">*</span></label>
        <input
          id="state-region"
          name="state_region"
          type="text"
          autocomplete="address-level1"
          required
        />
      </div>
      <div class="field">
        <label for="country">Country <span class="req" aria-hidden="true">*</span></label>
        <select id="country" name="country" autocomplete="country-name" required>
          <option value="">Select a country</option>
          {countryOptions.map((option) => <option value={option}>{option}</option>)}
        </select>
      </div>
      <div class="field">
        <label for="time-zone">Time Zone <span class="req" aria-hidden="true">*</span></label>
        <select id="time-zone" name="time_zone" required>
          <option value="">Select a time zone</option>
          {timeZoneOptions.map((option) => <option value={option}>{option}</option>)}
        </select>
      </div>
    </div>

    <fieldset class="volunteer-form-choice mt-6">
      <legend>Are you 18 or older? <span class="req" aria-hidden="true">*</span></legend>
      <div class="choice-row">
        <label class="choice">
          <input type="radio" name="age_18_or_older" value="Yes" required />
          <span>Yes</span>
        </label>
        <label class="choice">
          <input type="radio" name="age_18_or_older" value="No" required />
          <span>No</span>
        </label>
      </div>
    </fieldset>
  </section>

  <section class="volunteer-form-section" aria-labelledby="volunteer-interest-heading">
    <h3 id="volunteer-interest-heading" class="volunteer-form-section-title">Volunteer Interest</h3>
    <div class="field">
      <label for="why-volunteer">
        Why would you like to volunteer with Golden Archive Foundation?
        <span class="req" aria-hidden="true">*</span>
      </label>
      <textarea id="why-volunteer" name="why_volunteer" rows="4" required></textarea>
    </div>
    <div class="field mt-5">
      <label for="how-contribute">
        How would you like to contribute? <span class="req" aria-hidden="true">*</span>
      </label>
      <textarea id="how-contribute" name="how_contribute" rows="4" required></textarea>
    </div>
    <div class="field mt-5">
      <label for="work-interests">
        Are there particular kinds of work you are especially interested in?
      </label>
      <textarea id="work-interests" name="work_interests" rows="3"></textarea>
    </div>
  </section>

  <section class="volunteer-form-section" aria-labelledby="skills-heading">
    <h3 id="skills-heading" class="volunteer-form-section-title">Skills &amp; Experience</h3>
    <div class="field">
      <label for="skills-experience">
        Relevant skills and experience <span class="req" aria-hidden="true">*</span>
      </label>
      <textarea id="skills-experience" name="skills_experience" rows="4" required></textarea>
    </div>
    <div class="field mt-5">
      <label for="languages">Languages spoken / read / written</label>
      <input id="languages" name="languages" type="text" />
    </div>
    <div class="field mt-5">
      <label for="tools">Software, platforms, or technical tools</label>
      <input id="tools" name="tools" type="text" />
    </div>
    <div class="field mt-5">
      <label for="qualifications">Professional qualifications, certifications, or licenses</label>
      <textarea id="qualifications" name="qualifications" rows="3"></textarea>
    </div>
    <div class="field mt-5">
      <label for="prior-volunteer">Previous volunteer or nonprofit experience</label>
      <textarea id="prior-volunteer" name="prior_volunteer" rows="3"></textarea>
    </div>
  </section>

  <section class="volunteer-form-section" aria-labelledby="availability-heading">
    <h3 id="availability-heading" class="volunteer-form-section-title">Availability</h3>
    <div class="volunteer-form-grid">
      <div class="field">
        <label for="start-date">
          Available start date <span class="req" aria-hidden="true">*</span>
        </label>
        <input id="start-date" name="available_start_date" type="date" required />
      </div>
      <div class="field">
        <label for="time-commitment">
          Approximate time commitment <span class="req" aria-hidden="true">*</span>
        </label>
        <select id="time-commitment" name="time_commitment" required>
          <option value="">Select an option</option>
          {
            timeCommitmentOptions.map((option) => (
              <option value={option}>{option}</option>
            ))
          }
        </select>
      </div>
      <div class="field sm:col-span-2">
        <label for="volunteer-duration">
          Preferred volunteer duration <span class="req" aria-hidden="true">*</span>
        </label>
        <select id="volunteer-duration" name="volunteer_duration" required>
          <option value="">Select an option</option>
          {
            volunteerDurationOptions.map((option) => (
              <option value={option}>{option}</option>
            ))
          }
        </select>
      </div>
    </div>

    <fieldset class="volunteer-form-choice mt-6">
      <legend>Preferred availability <span class="req" aria-hidden="true">*</span></legend>
      <div class="choice-row">
        {
          preferredAvailabilityOptions.map((option) => (
            <label class="choice">
              <input type="checkbox" name="preferred_availability" value={option} />
              <span>{option}</span>
            </label>
          ))
        }
      </div>
      <p class="field-hint">Select all that apply.</p>
    </fieldset>
  </section>

  <section class="volunteer-form-section" aria-labelledby="supporting-heading">
    <h3 id="supporting-heading" class="volunteer-form-section-title">Supporting Information</h3>
    <div class="field">
      <label for="resume">
        Résumé / CV upload <span class="req" aria-hidden="true">*</span>
      </label>
      <input
        id="resume"
        name="resume"
        type="file"
        accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document"
        required
      />
      <p class="field-hint">PDF or Word document (DOC/DOCX), max 10 MB.</p>
    </div>
    <div class="volunteer-form-grid mt-5">
      <div class="field">
        <label for="linkedin">LinkedIn profile</label>
        <input id="linkedin" name="linkedin" type="url" placeholder="https://" autocomplete="url" />
      </div>
      <div class="field">
        <label for="portfolio">Portfolio / personal website</label>
        <input id="portfolio" name="portfolio" type="url" placeholder="https://" autocomplete="url" />
      </div>
    </div>
    <div class="field mt-5">
      <label for="work-sample">Additional file or work sample</label>
      <input
        id="work-sample"
        name="work_sample"
        type="file"
        accept=".pdf,.doc,.docx,.jpg,.jpeg,.png,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,image/jpeg,image/png"
      />
      <p class="field-hint">Optional. PDF, Word, JPG, or PNG, max 10 MB.</p>
    </div>
  </section>

  <section class="volunteer-form-section" aria-labelledby="reference-1-heading">
    <h3 id="reference-1-heading" class="volunteer-form-section-title">Reference 1</h3>
    <div class="volunteer-form-grid">
      <div class="field">
        <label for="ref1-name">Name <span class="req" aria-hidden="true">*</span></label>
        <input id="ref1-name" name="reference_1_name" type="text" required />
      </div>
      <div class="field">
        <label for="ref1-relationship">
          Relationship to you <span class="req" aria-hidden="true">*</span>
        </label>
        <input id="ref1-relationship" name="reference_1_relationship" type="text" required />
      </div>
      <div class="field">
        <label for="ref1-email">Email <span class="req" aria-hidden="true">*</span></label>
        <input id="ref1-email" name="reference_1_email" type="email" required />
      </div>
      <div class="field">
        <label for="ref1-phone">Phone <span class="req" aria-hidden="true">*</span></label>
        <input id="ref1-phone" name="reference_1_phone" type="tel" required />
      </div>
    </div>
  </section>

  <section class="volunteer-form-section" aria-labelledby="reference-2-heading">
    <h3 id="reference-2-heading" class="volunteer-form-section-title">Reference 2</h3>
    <div class="volunteer-form-grid">
      <div class="field">
        <label for="ref2-name">Name <span class="req" aria-hidden="true">*</span></label>
        <input id="ref2-name" name="reference_2_name" type="text" required />
      </div>
      <div class="field">
        <label for="ref2-relationship">
          Relationship to you <span class="req" aria-hidden="true">*</span>
        </label>
        <input id="ref2-relationship" name="reference_2_relationship" type="text" required />
      </div>
      <div class="field">
        <label for="ref2-email">Email <span class="req" aria-hidden="true">*</span></label>
        <input id="ref2-email" name="reference_2_email" type="email" required />
      </div>
      <div class="field">
        <label for="ref2-phone">Phone <span class="req" aria-hidden="true">*</span></label>
        <input id="ref2-phone" name="reference_2_phone" type="tel" required />
      </div>
    </div>
  </section>

  <section class="volunteer-form-section" aria-labelledby="additional-heading">
    <h3 id="additional-heading" class="volunteer-form-section-title">Additional Information</h3>
    <div class="field">
      <label for="additional-info">Anything else you would like us to know?</label>
      <textarea id="additional-info" name="additional_info" rows="4"></textarea>
    </div>
  </section>

  <section class="volunteer-form-section" aria-labelledby="declarations-heading">
    <h3 id="declarations-heading" class="volunteer-form-section-title">Declarations</h3>
    <div class="declaration-list">
      <label class="choice choice-block">
        <input type="checkbox" name="declare_references_contact" value="yes" required />
        <span>
          I confirm that the references listed above may be contacted by Golden Archive Foundation
          regarding my volunteer application.
          <span class="req" aria-hidden="true">*</span>
        </span>
      </label>
      <label class="choice choice-block">
        <input type="checkbox" name="declare_accuracy" value="yes" required />
        <span>
          I certify that the information provided in this application is accurate to the best of my
          knowledge.
          <span class="req" aria-hidden="true">*</span>
        </span>
      </label>
      <label class="choice choice-block">
        <input type="checkbox" name="declare_no_guarantee" value="yes" required />
        <span>
          I understand that submitting an application does not guarantee a volunteer placement.
          <span class="req" aria-hidden="true">*</span>
        </span>
      </label>
      <label class="choice choice-block">
        <input type="checkbox" name="declare_unpaid" value="yes" required />
        <span>
          I understand that volunteer roles with Golden Archive Foundation are unpaid.
          <span class="req" aria-hidden="true">*</span>
        </span>
      </label>
      <label class="choice choice-block">
        <input type="checkbox" name="declare_confidentiality" value="yes" required />
        <span>
          I understand that some volunteer roles may involve access to confidential information and
          may require additional confidentiality or data-handling requirements.
          <span class="req" aria-hidden="true">*</span>
        </span>
      </label>
    </div>

    <fieldset class="volunteer-form-choice mt-6">
      <legend>
        If a particular volunteer role requires a background check, are you willing to complete one?
        <span class="req" aria-hidden="true">*</span>
      </legend>
      <div class="choice-row">
        <label class="choice">
          <input type="radio" name="background_check_willing" value="Yes" required />
          <span>Yes</span>
        </label>
        <label class="choice">
          <input type="radio" name="background_check_willing" value="No" required />
          <span>No</span>
        </label>
      </div>
    </fieldset>
  </section>

  <div class="volunteer-turnstile" data-turnstile-widget aria-hidden="true"></div>

  <div class="volunteer-form-actions">
    <p
      class="volunteer-submit-status body-copy"
      data-submit-status
      aria-live="polite"
      aria-atomic="true"
    ></p>
    <button type="submit" class="btn-primary" data-submit-button disabled={!canSubmit}>
      Submit Volunteer Application
    </button>
  </div>
</form>

{
  canSubmit ? (
    <script
      is:inline
      src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"
      async
      defer
    ></script>
  ) : null
}

<script is:inline>
  document.querySelectorAll('.volunteer-form').forEach((form) => {
    const formAction = form.getAttribute('data-form-action') || '';
    const sitekey = form.getAttribute('data-turnstile-sitekey') || '';
    const submitButton = form.querySelector('[data-submit-button]');
    const statusEl = form.querySelector('[data-submit-status]');
    const widgetHost = form.querySelector('[data-turnstile-widget]');
    const idempotencyInput = form.querySelector('input[name="submission_idempotency_key"]');

    if (idempotencyInput && !idempotencyInput.value) {
      idempotencyInput.value =
        typeof crypto !== 'undefined' && crypto.randomUUID
          ? crypto.randomUUID()
          : String(Date.now()) + '-' + Math.random().toString(16).slice(2);
    }

    form.querySelectorAll('input[name="preferred_availability"]').forEach((box) => {
      box.addEventListener('change', () => {
        form
          .querySelectorAll('input[name="preferred_availability"]')
          .forEach((item) => item.setCustomValidity(''));
      });
    });

    if (!formAction || !sitekey || !submitButton || !statusEl || !widgetHost) {
      return;
    }

    let widgetId = null;
    let submitting = false;
    let tokenResolver = null;
    let tokenRejecter = null;

    function setStatus(message) {
      statusEl.textContent = message || '';
    }

    function errorMessageForStatus(status) {
      if (status === 413) {
        return 'This submission is too large. Please reduce file sizes and try again.';
      }
      if (status === 403) {
        return 'Verification failed. Please try again.';
      }
      if (status === 400) {
        return 'Please check the form and try again.';
      }
      return 'Something went wrong. Please try again.';
    }

    function ensureTurnstileTokenInput(token) {
      let input = form.querySelector('input[name="cf-turnstile-response"]');
      if (!input) {
        input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'cf-turnstile-response';
        form.appendChild(input);
      }
      input.value = token;
    }

    function executeTurnstile() {
      return new Promise((resolve, reject) => {
        tokenResolver = resolve;
        tokenRejecter = reject;
        if (widgetId === null || !window.turnstile) {
          reject(new Error('turnstile_unavailable'));
          return;
        }
        window.turnstile.execute(widgetId);
      });
    }

    function renderWidget() {
      if (!window.turnstile || widgetId !== null) return;
      widgetId = window.turnstile.render(widgetHost, {
        sitekey: sitekey,
        execution: 'execute',
        appearance: 'interaction-only',
        action: 'volunteer_submit',
        callback: function (token) {
          if (tokenResolver) {
            tokenResolver(token);
            tokenResolver = null;
            tokenRejecter = null;
          }
        },
        'error-callback': function () {
          if (tokenRejecter) {
            tokenRejecter(new Error('turnstile_error'));
            tokenResolver = null;
            tokenRejecter = null;
          }
          return true;
        },
        'expired-callback': function () {
          if (tokenRejecter) {
            tokenRejecter(new Error('turnstile_expired'));
            tokenResolver = null;
            tokenRejecter = null;
          }
        },
      });
    }

    function waitForTurnstile(attempt) {
      if (window.turnstile) {
        renderWidget();
        return;
      }
      if (attempt > 200) return;
      setTimeout(function () {
        waitForTurnstile(attempt + 1);
      }, 50);
    }

    waitForTurnstile(0);

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (submitting) return;

      const boxes = form.querySelectorAll('input[name="preferred_availability"]');
      if (boxes.length) {
        const checked = Array.from(boxes).some((box) => box.checked);
        if (!checked) {
          boxes[0].focus();
          boxes[0].setCustomValidity('Please select at least one preferred availability option.');
          boxes[0].reportValidity();
          return;
        }
        boxes.forEach((box) => box.setCustomValidity(''));
      }

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      submitting = true;
      submitButton.disabled = true;
      setStatus('Verifying…');

      try {
        if (widgetId === null) {
          renderWidget();
        }
        const token = await executeTurnstile();
        ensureTurnstileTokenInput(token);

        setStatus('Submitting your application…');
        const body = new FormData(form);
        const response = await fetch(formAction, {
          method: 'POST',
          body: body,
          credentials: 'same-origin',
        });

        let data = null;
        try {
          data = await response.json();
        } catch (_err) {
          data = null;
        }

        if (response.ok && data && data.success && data.submission_id) {
          setStatus(
            'Thank you. Your volunteer application has been received.\n\nApplication reference: ' +
              data.submission_id,
          );
          form.querySelectorAll('input, textarea, select, button').forEach((el) => {
            el.disabled = true;
          });
          return;
        }

        setStatus(errorMessageForStatus(response.status));
        if (window.turnstile && widgetId !== null) {
          window.turnstile.reset(widgetId);
        }
        submitButton.disabled = false;
        submitting = false;
      } catch (_err) {
        setStatus('Something went wrong. Please try again.');
        if (window.turnstile && widgetId !== null) {
          window.turnstile.reset(widgetId);
        }
        submitButton.disabled = false;
        submitting = false;
      }
    });
  });
</script>
