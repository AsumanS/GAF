---
import type { FactStatus } from '../../types/content';
import { factStatusLabel } from '../../types/content';

type Props = {
  status: FactStatus;
  class?: string;
};

const { status, class: className = '' } = Astro.props;
---

<span class:list={['meta inline-block text-ink-soft', className]}>
  {factStatusLabel[status]}
</span>
