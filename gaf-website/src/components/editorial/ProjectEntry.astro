---
import type { Project } from '../../data/projects';
import FactStatus from '../trust/FactStatus.astro';

type Props = {
  project: Project;
};

const { project } = Astro.props;
const bibliographic = project.layout === 'bibliographic';
---

<article
  class:list={[
    'rule-top pt-10',
    bibliographic
      ? 'lg:grid lg:grid-cols-12 lg:gap-10'
      : 'band-panel -mx-5 px-5 py-10 sm:-mx-8 sm:px-8',
  ]}
>
  <div class:list={[bibliographic ? 'lg:col-span-7' : 'max-w-3xl']}>
    <div class="flex flex-wrap items-baseline gap-x-4 gap-y-2">
      <span class="meta text-brass">{project.number}</span>
      <FactStatus status="in-progress" />
    </div>
    <h3 class="mt-3 font-display text-3xl sm:text-4xl">
      <a href={project.href} class="text-ink no-underline hover:text-oxblood">
        {project.title}
      </a>
    </h3>
    <p class="lede mt-4">{project.premise}</p>
  </div>

  <div
    class:list={[
      bibliographic ? 'mt-8 lg:col-span-5 lg:mt-0' : 'mt-8 grid gap-8 sm:grid-cols-2',
      bibliographic && 'border-l border-rule pl-5',
    ]}
  >
    <div>
      <h4 class="meta">Defined so far</h4>
      <ul class="mt-3 space-y-2 font-serif text-sm leading-relaxed text-ink-muted">
        {project.defined.map((item) => <li>{item}</li>)}
      </ul>
    </div>
    <div class={bibliographic ? 'mt-6' : ''}>
      <h4 class="meta">Still under development</h4>
      <ul class="mt-3 space-y-2 font-serif text-sm leading-relaxed text-ink-muted">
        {project.remaining.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </div>

  <p class:list={['mt-8', bibliographic && 'lg:col-span-12']}>
    <a href={project.href} class="editorial-link">{project.linkLabel}</a>
  </p>
</article>
