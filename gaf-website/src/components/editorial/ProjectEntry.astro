---
import type { Project } from '../../data/projects';

type Props = {
  project: Project;
  /** Zero-based position in the projects list — drives alternating image/text sides. */
  index: number;
};

const { project, index } = Astro.props;
/** Even rows: copy left / image right. Odd rows: image left / copy right. */
const imageFirst = index % 2 === 1;
---

<article class="project-entry rule-top py-10">
  <div
    class:list={[
      'grid items-center gap-8 lg:grid-cols-2 lg:gap-10',
      index % 2 === 1 && 'bg-canvas -mx-5 px-5 py-10 sm:-mx-8 sm:px-8 lg:py-10',
    ]}
  >
    <div
      class:list={[
        'project-entry-media border border-rule bg-panel',
        imageFirst ? 'order-1' : 'order-2',
      ]}
    >
      <img
        src={project.image.src}
        alt={project.image.alt}
        width="640"
        height="480"
        class="project-entry-img"
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class:list={['project-entry-copy', imageFirst ? 'order-2' : 'order-1']}>
      <h3 class="font-display text-3xl sm:text-4xl">
        <a href={project.href} class="text-ink no-underline hover:text-accent">
          {project.title}
        </a>
      </h3>
      {
        project.premise.map((paragraph) => (
          <p class="lede mt-4">{paragraph}</p>
        ))
      }
      <p class="mt-8">
        <a href={project.href} class="project-involve-cta">
          {project.linkLabel}
          <span aria-hidden="true">→</span>
        </a>
      </p>
    </div>
  </div>
</article>
