---
import Emblem from './Emblem.astro';
import { site } from '../config/site';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

const primaryNav = [
  { label: 'Projects', href: '/projects' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' },
];

function isCurrent(href: string): boolean {
  return pathname === href || pathname.startsWith(`${href}/`);
}

const donateHref = site.donationUrl || '/#donate';
---

<header class="sticky top-0 z-50 border-b border-rule bg-canvas/95 backdrop-blur-sm">
  <div class="site-shell flex flex-wrap items-center justify-between gap-x-4 gap-y-3 py-3">
    <a
      href="/"
      class="group flex min-w-0 items-center gap-2.5 text-ink no-underline hover:text-ink"
    >
      <span class="text-accent transition-colors group-hover:text-accent-dark" aria-hidden="true">
        <Emblem class="h-7 w-7" />
      </span>
      <span class="font-display text-lg leading-tight tracking-tight sm:text-xl">
        {site.organizationName}
      </span>
    </a>

    <div class="flex items-center gap-3 sm:gap-5">
      <nav class="hidden lg:block" aria-label="Primary">
        <ul class="flex items-center gap-5">
          {
            primaryNav.map((item) => (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    'font-sans text-sm font-medium text-ink-muted no-underline hover:text-ink',
                    isCurrent(item.href) &&
                      'text-ink underline decoration-accent decoration-2 underline-offset-8',
                  ]}
                  aria-current={isCurrent(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="hidden items-center gap-2 sm:flex">
        <a href="/volunteer" class="btn-volunteer-header">Volunteer</a>
        <a href={donateHref} class="btn-donate-header">Donate</a>
      </div>

      <button
        type="button"
        class="border border-rule px-3 py-2 font-sans text-sm font-medium text-ink lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        id="menu-toggle"
        data-menu-toggle
      >
        Menu
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="hidden border-t border-rule lg:hidden" data-mobile-nav hidden>
    <nav class="site-shell py-3" aria-label="Mobile primary">
      <ul class="flex flex-col gap-1">
        {
          primaryNav.map((item) => (
            <li>
              <a
                href={item.href}
                class="block px-1 py-2 font-sans text-sm font-medium text-ink-muted no-underline hover:text-ink"
                aria-current={isCurrent(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="flex flex-wrap gap-2 pt-3">
          <a href="/volunteer" class="btn-volunteer">Volunteer</a>
          <a href={donateHref} class="btn-donate">Donate</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script is:inline src="/js/menu.js" defer></script>
